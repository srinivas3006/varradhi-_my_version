components:
  examples:
    Forbidden403:
      summary: 403 forbidden envelope
      value:
        data: null
        meta: {}
        errors:
          code: 403
          message: You do not have permission to perform this action.
          details:
            detail: You do not have permission to perform this action.
    NotFound404:
      summary: 404 not found envelope
      value:
        data: null
        meta: {}
        errors:
          code: 404
          message: Not found.
          details:
            detail: Not found.
    ServerError500:
      summary: 500 server error envelope
      value:
        data: null
        meta: {}
        errors:
          code: 500
          message: Internal server error
          details: {}
    Throttled429:
      summary: 429 throttled envelope
      value:
        data: null
        meta: {}
        errors:
          code: 429
          message: Request was throttled.
          details:
            detail: Request was throttled.
    Unauthenticated401:
      summary: 401 unauthenticated envelope
      value:
        data: null
        meta: {}
        errors:
          code: 401
          message: Authentication credentials were not provided.
          details:
            detail: Authentication credentials were not provided.
    ValidationError400:
      summary: 400 validation error envelope
      value:
        data: null
        meta: {}
        errors:
          code: 400
          message: Validation error
          details:
            field:
            - This field is required.
  schemas:
    AdBanner:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        image_url:
          type: string
          format: uri
          description: S3/CDN URL of ad image uploaded from admin panel.
          maxLength: 500
        destination_url:
          type: string
          format: uri
          description: Where user lands after clicking the ad.
          maxLength: 1000
        ad_type:
          $ref: '#/components/schemas/AdBannerTypeEnum'
        placement_zone:
          $ref: '#/components/schemas/PlacementZoneEnum'
        target_scope:
          $ref: '#/components/schemas/AdTargetScopeEnum'
        area:
          type: object
          nullable: true
          properties:
            id:
              type: string
              format: uuid
            name:
              type: string
          readOnly: true
        display_frequency:
          type: integer
          maximum: 32767
          minimum: 0
          description: Show this ad after every N articles. Lower = more frequent.
        ctr:
          type: number
          format: double
          readOnly: true
      required:
      - area
      - ctr
      - id
      - image_url
    AdBannerAdmin:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        title:
          type: string
          description: Internal label for admin. Not shown to users.
          maxLength: 200
        image_url:
          type: string
          format: uri
          description: S3/CDN URL of ad image uploaded from admin panel.
          maxLength: 500
        destination_url:
          type: string
          format: uri
          description: Where user lands after clicking the ad.
          maxLength: 1000
        ad_type:
          $ref: '#/components/schemas/AdBannerTypeEnum'
        placement_zone:
          $ref: '#/components/schemas/PlacementZoneEnum'
        target_scope:
          $ref: '#/components/schemas/AdTargetScopeEnum'
        area:
          type: object
          nullable: true
          properties:
            id:
              type: string
              format: uuid
            name:
              type: string
            state:
              type: string
            district:
              type: string
            city:
              type: string
            village:
              type: string
            subdistrict:
              type: string
          readOnly: true
        display_frequency:
          type: integer
          maximum: 32767
          minimum: 0
          description: Show this ad after every N articles. Lower = more frequent.
        is_active:
          type: boolean
        start_date:
          type: string
          format: date-time
          nullable: true
        end_date:
          type: string
          format: date-time
          nullable: true
        impression_count:
          type: integer
          readOnly: true
        click_count:
          type: integer
          readOnly: true
        ctr:
          type: number
          format: double
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        deleted_at:
          type: string
          format: date-time
          nullable: true
      required:
      - area
      - click_count
      - created_at
      - ctr
      - id
      - image_url
      - impression_count
      - title
      - updated_at
    AdBannerAdminRequest:
      type: object
      properties:
        title:
          type: string
          minLength: 1
          description: Internal label for admin. Not shown to users.
          maxLength: 200
        image_url:
          type: string
          format: uri
          minLength: 1
          description: S3/CDN URL of ad image uploaded from admin panel.
          maxLength: 500
        destination_url:
          type: string
          format: uri
          description: Where user lands after clicking the ad.
          maxLength: 1000
        ad_type:
          $ref: '#/components/schemas/AdBannerTypeEnum'
        placement_zone:
          $ref: '#/components/schemas/PlacementZoneEnum'
        target_scope:
          $ref: '#/components/schemas/AdTargetScopeEnum'
        area_id:
          type: string
          format: uuid
          writeOnly: true
          nullable: true
        display_frequency:
          type: integer
          maximum: 32767
          minimum: 0
          description: Show this ad after every N articles. Lower = more frequent.
        is_active:
          type: boolean
        start_date:
          type: string
          format: date-time
          nullable: true
        end_date:
          type: string
          format: date-time
          nullable: true
        deleted_at:
          type: string
          format: date-time
          nullable: true
      required:
      - image_url
      - title
    AdBannerTypeEnum:
      enum:
      - banner
      - interstitial
      - native
      - video
      - poster
      - sponsored_card
      - breaking_strip
      - local_listing
      - full_screen
      - bottom_sticky
      type: string
      description: |-
        * `banner` - Banner Image
        * `interstitial` - Full Screen Interstitial
        * `native` - Native Feed Ad
        * `video` - Video Ad
        * `poster` - Poster Ad
        * `sponsored_card` - Sponsored Card
        * `breaking_strip` - Breaking Strip
        * `local_listing` - Local Listing
        * `full_screen` - Full Screen
        * `bottom_sticky` - Bottom Sticky
