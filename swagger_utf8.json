  /api/v1/articles/feed/:
    get:
      operationId: api_v1_articles_feed_retrieve
      description: 'Location-aware personalized feed. Ranking prioritizes district-level
        news first, then state-level (AP/Telangana), followed by regional (Andhra)
        and national/international content. Ingestion stores all valid articles; no
        hard filtering is performed at ingest time. Feed ranking uses `priority_score`
        computed during ingestion (location boosts, breaking status, trending categories,
        recency). Cache: unauthenticated requests are cached per region+page for a
        short TTL; caches are invalidated when articles are published/updated/deleted
        or when priority changes. Pagination uses cursor or page/page_size parameters;
        responses are paginated and include feed items in `results`.'
      parameters:
      - in: query
        name: breaking
        schema:
          type: boolean
        description: When true, return only breaking articles
      - in: query
        name: category
        schema:
          type: string
          enum:
          - business
          - entertainment
          - health
          - local
          - national
          - politics
          - science
          - sports
          - technology
        description: Category slug to filter feed
      - in: query
        name: city
        schema:
          type: string
        description: City name (alias for district)
      - in: query
        name: cursor
        schema:
          type: string
        description: Cursor token for pagination
      - in: query
        name: district
        schema:
          type: string
          enum:
          - Guntur
          - Hyderabad
          - Kadapa
          - Kakinada
          - Karimnagar
          - Khammam
          - Kurnool
          - Nellore
          - Nizamabad
          - Rajahmundry
          - Tirupati
          - Vijayawada
          - Vizag
          - Warangal
        description: 'District name for highest-priority local news. Telangana: Hyderabad,
          Warangal, Karimnagar, Khammam, Nizamabad. Andhra Pradesh: Vizag, Vijayawada,
          Guntur, Tirupati, Nellore, Kurnool, Kadapa, Rajahmundry, Kakinada.'
      - in: query
        name: lang
        schema:
          type: string
          enum:
          - en
          - hi
          - ta
          - te
        description: Language code for feed ordering
      - in: query
        name: latitude
        schema:
          type: number
          format: float
        description: User latitude for proximity-aware ranking
      - in: query
        name: longitude
        schema:
          type: number
          format: float
        description: User longitude for proximity-aware ranking
      - in: query
        name: page_size
        schema:
          type: integer
        description: Page size for page-based pagination (max 100)
      - in: query
        name: scope
        schema:
          type: string
          enum:
          - local
          - main
        description: main = broad ranked feed; local = strict location-filtered feed
          where supported by article location fields.
      - in: query
        name: state
        schema:
          type: string
          enum:
          - Andhra Pradesh
          - Telangana
        description: State name for location-aware ranking
      - in: query
        name: subdistrict
        schema:
          type: string
        description: Subdistrict/mandal name for guest/local ranking
      - in: query
        name: village
        schema:
          type: string
        description: Village name for guest/local ranking
      tags:
      - Feed & Articles
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ArticleFeedEnvelope'
              examples:
                ExampleResponse(paginated):
                  value:
                    results:
                    - title: Hyderabad Metro Expansion
                      state: Telangana
                      district: Hyderabad
                      priority_score: 95
                      slug: hyderabad-metro-expansion
                    next: null
                    previous: null
                  summary: Example response (paginated)
          description: ''
