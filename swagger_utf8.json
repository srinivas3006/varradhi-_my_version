openapi: 3.0.3
info:
  title: VARADHI Backend API
  version: 1.0.0
  description: |-
    OpenAPI documentation for VARADHI backend services.

    All responses are wrapped by a unified envelope at runtime: {"data": ..., "meta": ..., "errors": ...}.

    Frontend code generators must model this envelope and should not assume raw serializer responses at the HTTP response root.
paths:
