  /admin/api/articles/:
    get:
      operationId: admin_api_articles_list
      description: Admin article list. Use the detail endpoint to read or update thumbnail_url.
      parameters:
      - in: query
        name: author
        schema:
          type: string
        description: Filter by author user UUID.
      - in: query
        name: created_at
        schema:
          type: string
        description: Filter by created date, YYYY-MM-DD.
      - in: query
        name: status
        schema:
          type: string
        description: Filter by article status.
      tags:
      - Admin Articles
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ArticleEditorialQueue'
          description: ''
    post:
      operationId: admin_api_articles_create
      description: Create an article from the admin panel. Admin-created articles
        use the authenticated admin user as author and support draft, review, scheduled,
        and published statuses.
      tags:
      - Admin Articles
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ArticleCreateRequest'
            examples:
              AdminArticleCreateRequest:
                value:
                  title: Hyderabad Metro services extended
                  summary: Metro services will run longer for festival traffic.
                  content: Full article body content for the admin-created news story.
                  thumbnail_url: https://cdn.varadhi.example.com/articles/metro.jpg
                  thumbnail_upload: <image file; multipart/form-data only>
                  category: 2d35a2f8-0e71-45c0-a2d1-fec74ec1b7ff
                  language: en
                  status: published
                  is_featured: false
                  is_breaking: true
                  state: Telangana
                  district: Hyderabad
                  city: Hyderabad
                  village: Madhapur
                  subdistrict: Serilingampally
                  priority_score: 10
                  seo_title: Hyderabad Metro services extended
                  seo_description: Metro services will run longer for festival traffic.
                  seo_tags:
                  - hyderabad
                  - metro
                  source_name: VARADHI Desk
                summary: Admin article create request
              AdminArticleCreateMultipartFormFields:
                value:
                  title: Hyderabad Metro services extended
                  summary: Metro services will run longer for festival traffic.
                  content: Full article body content for the admin-created news story.
                  thumbnail_upload: <select image file>
                  category: 2d35a2f8-0e71-45c0-a2d1-fec74ec1b7ff
                  language: en
                  status: published
                  is_featured: false
                  is_breaking: true
                  state: Telangana
                  district: Hyderabad
                  city: Hyderabad
                  village: Madhapur
                  subdistrict: Serilingampally
                  priority_score: 10
                  location_tags: '["Telangana","Hyderabad","Madhapur","Serilingampally"]'
                  source_name: VARADHI Desk
                summary: Admin article create multipart form fields
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ArticleCreateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ArticleCreateRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ArticleAdmin'
          description: ''
  /admin/api/articles/{article_id}/:
    get:
      operationId: admin_api_articles_retrieve
      description: Get full admin article data, including thumbnail_url.
      parameters:
      - in: path
        name: article_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin Articles
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ArticleAdmin'
          description: ''
    patch:
      operationId: admin_api_articles_partial_update
      description: Update editable article fields. For API clients, set thumbnail_url
        to an existing CDN/S3 URL. The Django admin panel also has a thumbnail_upload
        form field that uploads a file and stores its URL in thumbnail_url.
      parameters:
      - in: path
        name: article_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin Articles
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedArticleAdminUpdateRequest'
            examples:
              AdminArticleUpdateRequest:
                value:
                  title: Updated article title
                  summary: Short article preview for feed cards.
                  content: Full article body content.
                  thumbnail_url: https://cdn.example.com/articles/photo.jpg
                  category: 2d35a2f8-0e71-45c0-a2d1-fec74ec1b7ff
                  language: en
                  is_featured: false
                  is_breaking: false
                  scheduled_at: '2026-06-06T10:30:00Z'
                  seo_title: Updated SEO title
                  seo_description: Updated SEO description.
                  seo_tags:
                  - news
                  - local
                  source_url: https://example.com/source
                  source_name: Reporter
                  state: Tamil Nadu
                  district: Chennai
                  priority_score: 10
                summary: Admin article update request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedArticleAdminUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedArticleAdminUpdateRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ArticleAdmin'
          description: ''
