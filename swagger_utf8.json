      tags:
      - Admin Articles
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ArticleThumbnailUploadRequestRequest'
            examples:
              RequestUploadURL:
                value:
                  filename: cover.jpg
                  content_type: image/jpeg
