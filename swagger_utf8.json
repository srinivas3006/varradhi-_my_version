    Recommendation:
      type: object
      description: Same as feed serializer but includes optional `tts_url`.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        title:
          type: string
        slug:
          type: string
          description: Auto-generated from title. Used in URLs and sharing.
          maxLength: 520
          pattern: ^[-a-zA-Z0-9_]+$
        summary:
          type: string
          description: Short preview shown in feed cards. 1-2 sentences.
        thumbnail_url:
          type: string
        category:
          allOf:
          - $ref: '#/components/schemas/Category'
          readOnly: true
        author_name:
          type: string
          readOnly: true
        source_name:
          type: string
          description: e.g., BBC News, Reuters, The Hindu
          maxLength: 200
        language:
          type: string
          description: ISO 639-1 language code.
          maxLength: 10
        is_featured:
          type: boolean
          description: Featured articles appear in the top carousel.
        is_breaking:
          type: boolean
        is_bookmarked:
          type: boolean
          readOnly: true
        share_url:
          type: string
          nullable: true
          readOnly: true
        read_time_minutes:
          type: integer
          maximum: 32767
          minimum: 0
          description: Estimated reading time. Calculated on save.
        view_count:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: Synced from Redis every 10 minutes. Not real-time.
        published_at:
          type: string
          format: date-time
          nullable: true
        state:
          type: string
          nullable: true
          maxLength: 50
        district:
          type: string
          nullable: true
          maxLength: 100
        village:
          type: string
          readOnly: true
        subdistrict:
          type: string
          readOnly: true
        is_regional:
          type: boolean
        priority_score:
          type: number
          format: double
        location_tags:
          description: 'List of matched location tags: ["Hyderabad","Telangana"]'
        tts_url:
          type: string
          format: uri
          readOnly: true
      required:
      - author_name
      - category
      - id
      - is_bookmarked
      - share_url
      - slug
      - subdistrict
      - title
      - tts_url
      - village
