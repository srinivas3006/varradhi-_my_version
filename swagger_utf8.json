  /admin/api/articles/thumbnail-upload-url/:
    post:
      operationId: admin_api_articles_thumbnail_upload_url_create
      description: Create a presigned S3 POST target for direct thumbnail upload.
        Frontend uploads the selected image to upload_url with returned fields, then
