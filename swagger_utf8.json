        * `REVIEW_REQUIRED` - Review Required
    VerifyOTPRequest:
      type: object
      properties:
        mobile:
          type: string
          minLength: 1
        otp:
          type: string
          minLength: 1
          maxLength: 6
          pattern: ^\d{6}$
      required:
      - mobile
      - otp
    VideoFeedEnvelope:
      type: object
      properties:
        data:
          type: array
          items:
            $ref: '#/components/schemas/VideoFeedItem'
        meta:
          $ref: '#/components/schemas/VideoFeedEnvelopeMeta'
        errors:
          nullable: true
      required:
      - data
      - errors
      - meta
    VideoFeedEnvelopeMeta:
      type: object
      properties:
        count:
          type: integer
          nullable: true
        next:
          type: string
          nullable: true
        previous:
          type: string
          nullable: true
    VideoFeedItem:
      type: object
      properties:
        id:
          type: string
        created_at:
          type: string
          format: date-time
          nullable: true
        updated_at:
          type: string
          format: date-time
          nullable: true
        title:
          type: string
        youtube_video_id:
          type: string
        youtube_url:
          type: string
          format: uri
        thumbnail_url:
          type: string
        description:
          type: string
        channel_name:
          type: string
        published_at:
          type: string
          format: date-time
          nullable: true
        is_live:
          type: boolean
        is_trending:
          type: boolean
        is_breaking:
          type: boolean
        is_short:
          type: boolean
        video_priority:
          type: integer
        state:
          type: string
          nullable: true
        district:
          type: string
        city:
          type: string
        subdistrict:
          type: string
        village:
          type: string
        location_tags:
          type: array
          items: {}
        language:
          type: string
        views_count:
          type: integer
        likes_count:
          type: integer
        concurrent_viewers:
          type: integer
        duration_seconds:
          type: integer
      required:
